# Study Hub 环境变量配置示例
# 复制为 .env 后按需填写：cp .env.example .env

# 服务端口
SERVER_PORT=8080

# MySQL 密码（使用 docker compose 或 SPRING_PROFILES_ACTIVE=mysql 时生效）
DB_PASSWORD=studyhub123

# 默认目标考试日期（YYYY-MM-DD，也可在网页底部栏随时点击修改）
APP_EXAM_DATE=

# 首次启动默认激活的 AI 提供方：
# mock (默认，无需 Key) | deepseek | ark | zhipu | openai_compat (Ollama/OpenAI/OpenRouter/硅基流动)
LLM_PROVIDER=mock

# 各大模型 API Key（启动后也可在前端「AI 模型」页面随时配置与热切换）
DEEPSEEK_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=

# 通用 OpenAI 兼容接口（默认指向本地 Ollama，支持无 Key 直连）
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=

# 是否额外注入演示作答历史与 Lv.3 游戏状态（默认 false，系统始终内置精品示例题库）
MOCK_ENABLED=false
